# Environment template for the SOH estimation project.
#
# MLflow settings live in config/default.yaml (`tracking.tracking_uri`,
# `tracking.experiment_name`); relative sqlite paths are anchored to the
# project root automatically by src/utils/tracking.py. The variables below
# exist purely as optional overrides for external tooling - no code in this
# repository reads environment variables.

# Optional: point tooling at the tracked database explicitly
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_EXPERIMENT_NAME=soh_benchmark
