# Environment variables for SOH Estimation project
# Copy this file to .env and fill in the values

# Weights & Biases (if using instead of MLflow)
# WANDB_API_KEY=
# WANDB_PROJECT=soh-estimation

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=soh_benchmark

# Data paths (override if datasets are stored elsewhere)
# NASA_PCOE_DATA_DIR=data/raw/nasa_pcoe
# CALCE_DATA_DIR=data/raw/calce
