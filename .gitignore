# ============================================================
# PROJECT-SPECIFIC IGNORES
# ============================================================

# Data (too large for version control)
data/raw/
data/processed/
data/features/

# DVC
.dvc/tmp/
.dvc/cache/

# Experiment artifacts (heavy/transient only)
experiments/mlruns/
experiments/artifacts/
experiments/scalers/
experiments/classical/
experiments/dl/

# Raw data products are reproducible via the pipeline; keep them local.
data/raw/
data/processed/
data/features/
*.pkl
*.h5

# Persisted fold models are large binaries; results YAMLs carry the metrics.
experiments/models/
*.joblib
*.pt
*.onnx
*.tflite

# Generated figures (regenerated by scripts/notebooks)
experiments/figures/
report/presentation/
!report/figures/
!report/figures/**

# NOTE: committed on purpose (single source of truth for all reported numbers):
#   experiments/classical_results_*.yaml
#   experiments/dl_results_*.yaml
#   experiments/fold_indices_*.json
#   experiments/robustness_*.yaml
#   experiments/deployability_*.yaml
#   experiments/analysis/*.yaml
#   mlflow.db (full run history)
#   report/numbers_manifest.json
!mlflow.db

